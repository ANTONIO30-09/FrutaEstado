# ============================================
# FrutaEstado - Variables de entorno
# Copia este archivo a .env y ajusta los valores reales.
# NUNCA subas .env al repositorio.
# ============================================

# --- ESP32 (compañero de hardware) ---
ESP32_IP=192.168.1.100
ESP32_PORT=80
ESP32_ENDPOINT=/estado

# --- Fuente de video (DroidCam / IP Webcam) ---
# Ejemplo DroidCam: http://192.168.1.50:4747/video
# Ejemplo IP Webcam: http://192.168.1.50:8080/video
CAM_URL=http://192.168.1.50:8080/video

# --- Dashboard Flask ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Base de datos ---
DB_PATH=data/frutas.db

# --- Perfil de fruta para clasificacion ---
# Opciones: default, platano, mandarina, manzana_verde,
#           manzana_roja, uva_verde, uva_morada
# Se pueden agregar mas perfiles en config/perfiles_custom.json
PERFIL_FRUTA=default
